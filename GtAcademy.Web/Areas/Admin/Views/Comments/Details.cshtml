@using GtAcademy.Application.Tools.PersianDateConverter;
@model GtAcademy.Application.Admin.CourseComments.Queries.GetCourseCommentDetailsForAdmin.CourseCommentDetailsDto

@{
    ViewData["Title"] = "جزئیات کامنت";
}



<div class="card">
    <div class="card-body">
        <h1>جزئیات کامنت</h1>

        <div>
            <hr />
            <img class="img-thumbnail" style="width:20%" src="/assets/img/users/@Model.User.AvatarName" />
            <dl class="row">
                <dt class="col-sm-2">
                    نام کاربری
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.User.UserName)
                </dd>
                <dt class="col-sm-2">
                    دوره
                </dt>
                <dd class="col-sm-10">
                    <a href="/coursedetails/@Model.CourseId">@Model.CourseTitle</a>
                </dd>
                <dt class="col-sm-2">
                    متن
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Content)
                </dd>
                <dt class="col-sm-2">
                    تاریخ ایجاد
                </dt>
                <dd class="col-sm-10">
                    @Model.CreateDate.ToShamsi().FixShamsiDate()
                </dd>
                <dt class="col-sm-2">
                    تایید شده
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.AdminSubmited)
                </dd>
            </dl>
        </div>
        <div> 
            <a asp-action="SubmitComment" asp-route-id="@Model.CommentId" class="link-success">تایید</a> |
            <a asp-action="Delete" asp-route-id="@Model.CommentId" class="link-danger">حذف</a> |
            <a class="link-info" asp-action="Index">برگشت به لیست کامنت ها</a>
        </div>
    </div>
</div>
