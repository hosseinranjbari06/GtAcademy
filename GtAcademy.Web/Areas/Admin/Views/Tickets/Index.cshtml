@using GtAcademy.Application.Forum.Queries.GetForumQuestionsList
@using GtAcademy.Application.Tools.PersianDateConverter
@model List<ForumQuestionsListItemDto>

@{
    ViewData["Title"] = "تیکت ها";
}

<div class="breadcrumb-with-buttons mb-24 flex-between flex-wrap gap-8">
    <!-- Breadcrumb Start -->
    <div class="breadcrumb mb-24">
        <ul class="flex-align gap-4">
            <li><a href="/Admin" class="text-gray-200 fw-normal text-15 hover-text-main-600">خانه</a></li>
            <li> <span class="text-gray-500 fw-normal d-flex"><i class="ph ph-caret-left"></i></span> </li>
            <li><span class="text-main-600 fw-normal text-15">تیکت ها</span></li>
        </ul>
    </div>
    <!-- Breadcrumb End -->
</div>


<div class="card mt-24">
    <div class="card-body">
        <form name="pageForm" id="pageForm" asp-action="Index" asp-controller="Tickets" asp-area="Admin" class="search-input-form">
            <input id="PageId" name="PageId" value="@ViewBag.Search.PageId" type="hidden" />

            <div class="search-input">
                <input class="form-control h6 rounded-4 mb-0 py-6 px-8" type="text" name="TitleSearch" placeholder="عنوان" value="@ViewBag.Search.TitleSearch" />
            </div>

            @{
                var countItems = new List<SelectListItem>()
                        {
                        new SelectListItem(){Text = "تعداد نمایش",Value = ""},
                        new SelectListItem(){Text = "2",Value = "2"},
                        new SelectListItem(){Text = "10",Value = "10"},
                        new SelectListItem(){Text = "20",Value = "20"},
                        new SelectListItem(){Text = "50",Value = "50"},
                        new SelectListItem(){Text = "100",Value = "100"},
                        };
                var countSelect = new SelectList(countItems, "Value", "Text", ViewBag.Search.Take);
            }
            <div class="search-input">
                <select name="Take" asp-items="@countSelect" class="form-control form-select h6 rounded-4 mb-0 py-6 px-8">
                </select>
            </div>

            @{
                var closeItems = new List<SelectListItem>()
                        {
                        new SelectListItem(){Text = "وضعیت",Value = ""},
                        new SelectListItem(){Text = "باز",Value = "false"},
                        new SelectListItem(){Text = "بسته شده",Value = "true"}
                        };
                var closeSelect = new SelectList(closeItems, "Value", "Text", ViewBag.Search.IsClosed);
            }
            <div class="search-input">
                <select name="IsClosed" asp-items="@closeSelect" class="form-control form-select h6 rounded-4 mb-0 py-6 px-8">
                </select>
            </div>
@* 
            <div class="form-check mb-0 flex-shrink-0">
                <input name="IsClosed" id="IsClosed" @(ViewBag.Search.IsClosed == true ? "checked" : "") class="form-check-input flex-shrink-0 rounded-4" type="checkbox">
                <label class="form-check-label text-15 flex-grow-1" for="remember">بسته شده</label>
            </div> *@

            <div class="search-input">
                <button type="submit" class="btn btn-main rounded-pill py-9 w-100">جستجو</button>
            </div>
        </form>
    </div>
</div>
<br />
<div class="card overflow-hidden">
    <div class="card-body p-0 overflow-x-auto">
        <div id="studentTable_wrapper" class="dt-container dt-empty-footer">
            <div class="dt-layout-row"><div class="dt-layout-cell dt-start "></div><div class="dt-layout-cell dt-end "></div></div><div class="dt-layout-row dt-layout-table">
            <div class="dt-layout-cell ">
                <table id="studentTable" class="table table-striped dataTable" style="width: 1285px;">
                    <colgroup><col data-dt-column="0" style="width: 80px;"><col data-dt-column="1" style="width: 130px;"><col data-dt-column="2" style="width: 125px;"><col data-dt-column="3" style="width: 90px;"><col data-dt-column="4" style="width: 80px;"><col data-dt-column="5" style="width: 80px;"><col data-dt-column="6" style="width: 180px;"></colgroup>
                    <thead>
                        <tr role="row">
                            <th class="h6 text-gray-300 dt-orderable-asc dt-orderable-desc" aria-label="دانش‌آموزان: Activate to sort" data-dt-column="1" rowspan="1" colspan="1" tabindex="0"><span class="dt-column-title" role="button">کاربر</span></th>
                            <th class="h6 text-gray-300 dt-type-numeric dt-orderable-asc dt-orderable-desc" data-dt-column="3" rowspan="1" colspan="1" tabindex="0"><span class="dt-column-title" role="button">‌عنوان</span></th>
                            <th class="h6 text-gray-300 dt-type-numeric dt-orderable-asc dt-orderable-desc" data-dt-column="4" rowspan="1" colspan="1" tabindex="0"><span class="dt-column-title" role="button">دوره</span></th>
                            <th class="h6 text-gray-300 dt-orderable-asc dt-orderable-desc" data-dt-column="5" rowspan="1" colspan="1" tabindex="0"><span class="dt-column-title" role="button">تاریخ ایجاد</span></th>
                            <th class="h6 text-gray-300 dt-orderable-asc dt-orderable-desc" data-dt-column="5" rowspan="1" colspan="1" tabindex="0"><span class="dt-column-title" role="button">تعداد پاسخ</span></th>
                            <th class="h6 text-gray-300 dt-orderable-asc dt-orderable-desc" data-dt-column="5" rowspan="1" colspan="1" tabindex="0"><span class="dt-column-title" role="button">وضعیت</span></th>
                            <th class="h6 text-gray-300 dt-orderable-none" data-dt-column="6" rowspan="1" colspan="1" aria-label="اقدامات"><span class="dt-column-title">اقدامات</span><span class="dt-column-order"></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td>
                                    <div class="flex-align gap-8">
                                        <img src="/assets/img/users/@ticket.UserAvatarName" alt="" class="w-40 h-40 rounded-circle">
                                    </div>
                                </td>
                                <td>
                                    <span class="h6 mb-0 fw-medium text-gray-300">@ticket.Title</span>
                                </td>
                                <td>
                                    <a href="/coursedetails/@ticket.CourseId" class="h6 mb-0 fw-medium text-gray-300">@ticket.CourseTitle</a>
                                </td>
                                <td>
                                    <span class="h6 mb-0 fw-medium text-gray-300">@ticket.CreateDate.ToShamsi().FixShamsiDate()</span>
                                </td>
                                <td>
                                    <span class="h6 mb-0 fw-medium text-gray-300">@ticket.AnswersCount</span>
                                </td>
                                <td>
                                    @if (!ticket.IsClosed)
                                    {
                                        <span class="text-13 py-2 px-8 bg-success-50 text-success-600 d-inline-flex align-items-center gap-8 rounded-pill">
                                            <span class="w-6 h-6 bg-success-600 rounded-circle flex-shrink-0"></span>
                                            باز
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-13 py-2 px-8 bg-warning-50 text-warning-600 d-inline-flex align-items-center gap-8 rounded-pill">
                                            <span class="w-6 h-6 bg-warning-600 rounded-circle flex-shrink-0"></span>
                                            بسته شده
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a href="/ShowTicket/@ticket.QuestionId" class="bg-main-50 text-main-600 py-2 px-14 rounded-pill hover-bg-main-600 hover-text-white">نمایش</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot></tfoot>
                </table>
            </div>
        </div><div class="dt-layout-row"><div class="dt-layout-cell dt-start "></div><div class="dt-layout-cell dt-end "></div></div>
    </div>
</div>
<div class="card-footer flex-between flex-wrap">
    <ul class="pagination flex-align flex-wrap">

        @if (ViewBag.PagesCount < 9)
        {
            for (int i = 1; i < ViewBag.PagesCount + 1; i++)
            {
                <li class="page-item @((i == ViewBag.Search.PageId) ? "active" : "")">
                    <a onclick="ChangePage(@i)" href="#" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@i</a>
                </li>
            }
        }
        else
        {
            <li class="page-item @((1 == ViewBag.Search.PageId) ? "active" : "")">
                <a onclick="ChangePage(1)" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">1</a>
            </li>
            <li class="page-item @((2 == ViewBag.Search.PageId) ? "active" : "")">
                <a onclick="ChangePage(2)" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">2</a>
            </li>
            <li class="page-item @((3 == ViewBag.Search.PageId) ? "active" : "")">
                <a onclick="ChangePage(3)" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">3</a>
            </li>
            <li class="page-item">
                <a class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium" href="#">...</a>
            </li>

            @if (ViewBag.Search.PageId > 2 && ViewBag.Search.PageId < ViewBag.PagesCount - 1)
            {
                <li class="page-item">
                    <a onclick="ChangePage(@(ViewBag.Search.PageId - 1))" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@(ViewBag.Search.PageId - 1)</a>
                </li>
                <li class="page-item active">
                    <a class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@(ViewBag.Search.PageId)</a>
                </li>
                <li class="page-item">
                    <a onclick="ChangePage(@(ViewBag.Search.PageId + 1))" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@(ViewBag.Search.PageId + 1)</a>
                </li>
            }

            <li class="page-item">
                <a class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium" href="#">...</a>
            </li>
            <li class="page-item @((ViewBag.PagesCount - 2 == ViewBag.Search.PageId) ? "active" : "")">
                <a onclick="ChangePage(@(ViewBag.PagesCount - 2))" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@(ViewBag.PagesCount - 2)</a>
            </li>
            <li class="page-item @((ViewBag.PagesCount - 1 == ViewBag.Search.PageId) ? "active" : "")">
                <a onclick="ChangePage(@(ViewBag.PagesCount - 1))" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@(ViewBag.PagesCount - 1)</a>
            </li>
            <li class="page-item @((ViewBag.PagesCount - 2 == ViewBag.Search.PageId) ? "active" : "")">
                <a onclick="ChangePage(@(ViewBag.PagesCount))" class="page-link h-44 w-44 flex-center text-15 rounded-8 fw-medium">@ViewBag.PagesCount</a>
            </li>
        }

    </ul>
</div>
</div>

@section Scripts {
    <script type="text/javascript">
        function ChangePage(pageid) {
            $("#PageId").val(pageid);
            $("#pageForm").submit();
        }
    </script>
}