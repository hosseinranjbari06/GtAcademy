@using GtAcademy.Application.Courses.Common
@using GtAcademy.Application.Users.Common
@model GtAcademy.Application.Admin.Courses.Commands.CreateCourseByAdmin.CreateCourseDto

@{
    ViewData["Title"] = "افزودن دوره جدید";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-1">افزودن دوره جدید</h4>
                <small class="text-muted">ساخت دوره با اطلاعات پایه، بنر و فایل‌های آموزشی</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">بازگشت به لیست دوره‌ها</a>
        </div>

        <form id="courseCreateForm" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="mb-3">
                        <label class="form-label">عنوان دوره</label>
                        <input asp-for="Title" class="form-control" placeholder="مثلاً ASP.NET Core پیشرفته" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">تگ‌ها</label>
                        <input asp-for="Tags" class="form-control" placeholder="dotnet, aspnet, backend" />
                        <span asp-validation-for="Tags" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">قیمت (به تومان)</label>
                        <input asp-for="Price" type="number" min="0" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">بنر دوره</label>
                        <input name="bannerFile" type="file" accept="image/*" class="form-control" />
                        <span asp-validation-for="BannerName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">فایل‌های دوره</label>
                        <input id="courseFilesInput" name="courseFiles" type="file" class="form-control" multiple accept=".zip,.rar,.pdf,.mp4,.mp3,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.jpg,.jpeg,.png,.webp" />
                        <div class="form-text">فایل‌های آموزشی، جزوه، و محتوای دوره را انتخاب کنید.</div>
                        <span asp-validation-for="BannerName" class="text-danger small"></span>
                    </div>

                    <div class="card border-light bg-light mb-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>فایل‌های انتخابی</strong>
                                <span id="selectedFilesCount" class="badge text-bg-primary">0</span>
                            </div>
                            <ul id="selectedFilesList" class="list-unstyled mb-0 small text-muted">
                                <li>هیچ فایلی انتخاب نشده است.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block">مدرس</label>
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            @foreach (UserSummaryDto teacher in ViewBag.Teachers)
                            {
                                <label class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                                    <input name="TeacherId" value="@teacher.UserId" class="form-check-input mt-0" type="radio" />
                                    <img src="/assets/img/users/@teacher.AvatarName" alt="@teacher.UserName" class="rounded-circle" width="36" height="36" style="object-fit: cover;" />
                                    <span>@teacher.UserName</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="TeacherId" class="text-danger small d-block mt-2"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block">دسته‌بندی</label>
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            @foreach (CourseCategoryDto category in ViewBag.Categories)
                            {
                                <label class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                                    <input name="CategoryId" value="@category.CategoryId" class="form-check-input mt-0" type="radio" />
                                    <span>@category.Title</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="CategoryId" class="text-danger small d-block mt-2"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="submit" class="btn btn-primary px-4">ایجاد دوره</button>
                        <div class="text-muted small" id="uploadStatus">در انتظار ارسال</div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="mb-3">
                        <label class="form-label">توضیحات دوره</label>
                        <textarea id="classic" asp-for="Description" class="form-control" rows="12"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </form>

        <div class="mt-4">
            <div class="progress" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" style="height: 12px;">
                <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 0%"></div>
            </div>
            <div id="uploadProgressText" class="small text-muted mt-2">پیشرفت آپلود: 0%</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/5vve5og4xwplevo4rcsxa2ave1fe14lje1d34j9c0jwubhb9/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script>
        const courseCreateForm = document.getElementById('courseCreateForm');
        const courseFilesInput = document.getElementById('courseFilesInput');
        const selectedFilesList = document.getElementById('selectedFilesList');
        const selectedFilesCount = document.getElementById('selectedFilesCount');
        const uploadProgressBar = document.getElementById('uploadProgressBar');
        const uploadProgressText = document.getElementById('uploadProgressText');
        const uploadStatus = document.getElementById('uploadStatus');

        function updateSelectedFilesList() {
            const files = Array.from(courseFilesInput.files || []);
            if (!files.length) {
                selectedFilesList.innerHTML = '<li>هیچ فایلی انتخاب نشده است.</li>';
                selectedFilesCount.textContent = '0';
                return;
            }

            selectedFilesCount.textContent = String(files.length);
            selectedFilesList.innerHTML = files.map(file => {
                const sizeInMb = (file.size / (1024 * 1024)).toFixed(2);
                return `<li class="d-flex justify-content-between align-items-center border-bottom py-2"><span>${file.name}</span><span class="text-muted">${sizeInMb} MB</span></li>`;
            }).join('');
        }

        courseFilesInput.addEventListener('change', updateSelectedFilesList);

        courseCreateForm.addEventListener('submit', function (event) {
            event.preventDefault();

            const formData = new FormData(courseCreateForm);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            uploadStatus.textContent = 'در حال آپلود...';
            uploadStatus.className = 'text-muted small';
            uploadProgressBar.style.width = '0%';
            uploadProgressText.textContent = 'پیشرفت آپلود: 0%';

            const xhr = new XMLHttpRequest();
            xhr.open('POST', courseCreateForm.action, true);
            xhr.setRequestHeader('RequestVerificationToken', token);

            xhr.upload.addEventListener('progress', function (e) {
                if (!e.lengthComputable) return;
                const percent = Math.round((e.loaded / e.total) * 100);
                uploadProgressBar.style.width = percent + '%';
                uploadProgressBar.setAttribute('aria-valuenow', percent);
                uploadProgressText.textContent = 'پیشرفت آپلود: ' + percent + '%';
            });

            xhr.onload = function () {
                if (xhr.status >= 200 && xhr.status < 300) {
                    if (xhr.responseURL && xhr.responseURL !== courseCreateForm.action) {
                        window.location.href = xhr.responseURL;
                        return;
                    }

                    window.location.href = '/Admin/Courses';
                    return;
                }

                uploadStatus.textContent = 'خطا در ارسال فرم';
                uploadStatus.className = 'text-danger small';
                uploadProgressBar.style.width = '0%';
                uploadProgressText.textContent = 'آپلود ناموفق بود';
            };

            xhr.onerror = function () {
                uploadStatus.textContent = 'خطا در ارتباط با سرور';
                uploadStatus.className = 'text-danger small';
                uploadProgressBar.style.width = '0%';
                uploadProgressText.textContent = 'آپلود ناموفق بود';
            };

            xhr.send(formData);
        });

        tinymce.init({
            selector: 'textarea',
            plugins: [
                'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media', 'searchreplace', 'table', 'visualblocks', 'wordcount'
            ],
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link media table | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent',
            menubar: false,
            height: 420,
            content_style: 'body { font-family: Vazirmatn, sans-serif; }'
        });
    </script>

    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
