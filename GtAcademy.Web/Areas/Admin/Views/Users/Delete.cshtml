@using GtAcademy.Application.Tools.PersianDateConverter
@model GtAcademy.Application.Admin.Users.Queries.GetUserDetailsForAdmin.UserDetailsDto

@{
    ViewData["Title"] = "حذف کاربر";
}

<div class="card">
    <div class="card-body">
        <h1>حذف کاربر</h1>

        <div>
            <hr />
            <img class="img-thumbnail" style="width:20%" src="/assets/img/users/@Model.AvatarName" />
            <dl class="row">
                <dt class="col-sm-2">
                    نام کاربری
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.UserName)
                </dd>
                <dt class="col-sm-2">
                    ایمیل
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.EmailAddress)
                </dd>
                <dt class="col-sm-2">
                    تلفن همراه
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.PhoneNumber)
                </dd>
                <dt class="col-sm-2">
                    توکن فعالسازی حساب
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.VerifyToken)
                </dd>
                <dt class="col-sm-2">
                    فعال بودن حساب
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.IsActive)
                </dd>
                <dt class="col-sm-2">
                    آدرس
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.HomeAddress)
                </dd>
                <dt class="col-sm-2">
                    شغل
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Job)
                </dd>
                <dt class="col-sm-2">
                    بیوگرافی
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Biography)
                </dd>
                <dt class="col-sm-2">
                    تاریخ تولد
                </dt>
                <dd class="col-sm-10">
                    @if (Model.BirthDate != null)
                    {
                        @Model.BirthDate?.ToShamsi().FixShamsiDate()
                    }
                </dd>
                <dt class="col-sm-2">
                    تاریخ ثبت نام
                </dt>
                <dd class="col-sm-10">
                    @Model.RegisterDate.ToShamsi().FixShamsiDate()
                </dd>
                <dt class="col-sm-2">
                    کد معرف
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ReferralCode)
                </dd>
            </dl>
            <h3>ایا از حذف این کاربر مطمئن هستید ؟</h3>

            <form asp-action="Delete">
                <input type="hidden" asp-for="UserId" />
                <input type="submit" value="حذف کاربر" class="btn btn-danger" /> |
                <a asp-action="Index">Back to List</a>
            </form>
        </div>
    </div>
</div>
