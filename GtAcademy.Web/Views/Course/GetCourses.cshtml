@using GtAcademy.Application.Courses.Common
@model List<CourseSummaryDto>

@{
	ViewData["Title"] = "دوره ها";
}

<section class="page-header">
    <div class="bg-item">
        <div class="bg-img" data-background="assets/img/bg-img/page-header-bg.png" style="background-image: url(&quot;assets/img/bg-img/page-header-bg.png&quot;);"></div>
        <div class="overlay"></div>
        <div class="shapes">
            <div class="shape shape-1">
                <img alt="shape" src="assets/img/shapes/page-header-shape-1.png">
            </div>
            <div class="shape shape-2">
                <img alt="shape" src="assets/img/shapes/page-header-shape-2.png">
            </div>
            <div class="shape shape-3">
                <img alt="shape" src="assets/img/shapes/page-header-shape-3.png">
            </div>
        </div>
    </div>
    <div class="container">
        <div class="page-header-content">
            <h1 class="title">صفحه دوره</h1>
            <h4 class="sub-title">
                <a class="home" href="/">خانه</a><span class="icon">/</span><a class="inner-page" href="#">صفحه دوره</a>
            </h4>
        </div>
    </div>
</section>

@if (Model.Any())
{
    <section class="feature-course bg-white pt-120 pb-120">
        <div class="container">
            <div class="section-heading text-center">
                <h4 class="sub-heading wow fade-in-bottom" data-wow-delay="200ms" style="visibility: visible; animation-delay: 200ms; animation-name: fade-in-bottom;">
                    <span class="heading-icon"><i class="fa-sharp fa-solid fa-bolt"></i></span>دوره های کلاس بالا
                </h4>
                <h2 class="section-title wow fade-in-bottom" data-wow-delay="400ms" style="visibility: visible; animation-delay: 400ms; animation-name: fade-in-bottom;">
                    دوره های برجسته را کاوش کنید
                </h2>
            </div>
            <div class="row gy-4 justify-content-center">
                @foreach (var course in Model)
                {
                    <div class="col-xl-4 col-lg-6 col-md-6">
                        <div class="course-item wow fade-in-bottom" data-wow-delay="200ms" style="visibility: visible; animation-delay: 200ms; animation-name: fade-in-bottom;">
                            <div class="course-thumb-wrap">
                                <div class="course-thumb">
                                    <img alt="course" src="assets/img/images/@course.BannerName">
                                </div>
                            </div>
                            <div class="course-content">
                                <span class="offer">اقتصاد</span>
                                <h3 class="title">
                                    <a href="/coursedetails/@course.CourseId">@course.Title</a>
                                </h3>
                                <ul class="course-list">
                                    <li><i class="fa-light fa-file"></i>تعداد ویدیو : @course.EpisodeCount</li>
                                    <li><i class="fa-light fa-clock"></i>مدت زمان : @course.TotalTime</li>
                                </ul>
                                <div class="course-author-box">
                                    <div class="course-author">
                                        <div class="author-img">
                                            <img alt="course" src="assets/img/users/@course.TeacherSummary.AvatarName">
                                        </div>
                                        <div class="author-info">
                                            <h4 class="name">@course.TeacherSummary.UserName</h4>
                                            <span>مربی</span>
                                        </div>
                                    </div>
                                    <ul class="course-review">
                                        <li><i class="fa-sharp fa-solid fa-star"></i></li>
                                        <li><i class="fa-sharp fa-solid fa-star"></i></li>
                                        <li><i class="fa-sharp fa-solid fa-star"></i></li>
                                        <li><i class="fa-sharp fa-solid fa-star"></i></li>
                                        <li><i class="fa-sharp fa-solid fa-star"></i></li>
                                        <li class="point">(4.7)</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="bottom-content">
                                <span class="price">@course.Price تومان</span>
                                <a class="course-btn" href="/coursedetails/@course.CourseId">مشاهده جزئیات</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}