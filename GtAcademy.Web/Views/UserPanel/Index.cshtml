@using GtAcademy.Application.Users.Queries.GetUserProfile
@using GtAcademy.Application.Tools.PersianDateConverter
@model UserProfileDto
@{
    ViewData["Title"] = "پنل کاربری";
}

<section class="page-header">
    <div class="bg-item">
        <div class="bg-img" data-background="assets/img/bg-img/page-header-bg.png" style="background-image: url(&quot;assets/img/bg-img/page-header-bg.png&quot;);"></div>
        <div class="overlay"></div>
        <div class="shapes">
            <div class="shape shape-1">
                <img alt="shape" src="assets/img/shapes/page-header-shape-1.png">
            </div>
            <div class="shape shape-2">
                <img alt="shape" src="assets/img/shapes/page-header-shape-2.png">
            </div>
            <div class="shape shape-3">
                <img alt="shape" src="assets/img/shapes/page-header-shape-3.png">
            </div>
        </div>
    </div>
    <div class="container">
        <div class="page-header-content">
            <h1 class="title">پنل کاربری</h1>
            <h4 class="sub-title">
                <a class="home" href="/">خانه</a><span class="icon">/</span><a class="inner-page" href="#">پنل کاربری</a>
            </h4>
        </div>
    </div>
</section>

<section class="event-details pt-120 pb-120">
    <div class="container">
        <div class="row gy-xl-0 gy-5">
            <div class="col-lg-4 col-md-12">
                <partial name="_ProfileSideBar" />
            </div>
            <div class="col-lg-8 col-md-12">
                <div class="event-details-content">
                    <div class="checkout-left">
                        <h3 class="form-header">پروفایل</h3>
                        <div class="checkout-form-wrap">
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <div class="form-item">
                                        <h4 class="form-title">آدرس ایمیل</h4>
                                        <input disabled class="form-control" id="email" name="email" type="email" value="@Model.EmailAddress">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-item name">
                                        <h4 class="form-title">شماره تلفن</h4>
                                        <input disabled class="form-control" id="fullname-2" name="fullname-2" value="@Model.PhoneNumber" type="text">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-6">
                                    <div class="form-item">
                                        <h4 class="form-title">تاریخ تولد</h4>
                                        <input disabled class="form-control" id="email" name="email" value="@(Model.BirthDate?.ToShamsi())">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-item name">
                                        <h4 class="form-title">شغل</h4>
                                        <input disabled class="form-control" id="fullname-2" name="fullname-2" value="@Model.Job" type="text">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <div class="form-item">
                                        <h4 class="form-title">آدرس</h4>
                                        <input disabled class="form-control" id="email" name="email" value="@Model.HomeAddress">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <div class="form-item">
                                        <h4 class="form-title">بیوگرافی</h4>
                                        <textarea disabled class="form-control address" cols="30" id="message" name="message" rows="4">@Model.Biography</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>