# Example environment file for docker-compose
# Copy to .env on the host and fill real secrets (DO NOT commit real secrets to Git)

# SQL Server SA password (must meet SQL Server complexity requirements)
SA_PASSWORD=YourStrong!Passw0rd

# Connection string used by the app inside Docker Compose
# Use server name 'db' because compose service name becomes hostname
ConnectionStrings__GtAcademyConnectionString=Server=db;Database=GtAcademy_Db;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;Application Intent=ReadWrite;Command Timeout=30

# SMS sender settings (fill if used)
SmsSenderSettings__ApiKey=REPLACE_WITH_REAL_KEY
SmsSenderSettings__TemplateId=200000
